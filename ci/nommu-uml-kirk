#!/usr/bin/env python3
"""Run Kirk with the NOMMU UML Docker communication plugin preloaded."""

import os
import sys

repo_root = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, os.path.join(repo_root, "tools", "kirk", "kirk-src"))

import libkirk.com
import libkirk.ltp
import libkirk.main

# Forward guest-local shared library paths to LTP test commands.
libkirk.ltp.LTPFramework.SUPPORTED_ENV |= frozenset({"LD_LIBRARY_PATH"})

libkirk.com.discover(os.path.join(repo_root, "ci"))
libkirk.main.run()
