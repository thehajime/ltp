#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
LTPROOT=${LTPROOT:?set LTPROOT to the installed LTP tree}
image=${NOMMU_UML_IMAGE:-ghcr.io/thehajime/alpine:3.20.3-um-nommu}
status_file="$LTPROOT/tmp/kirk-in-guest-exit"
report_file="$LTPROOT/tmp/kirk-in-guest-report.json"
log_file="$LTPROOT/tmp/kirk-in-guest.log"
suite_file="$LTPROOT/tmp/kirk-in-guest-suite"
pattern_file="$LTPROOT/tmp/kirk-in-guest-pattern"
suite=${KIRK_GUEST_SUITE:-syscalls}

if [ ! -d "$LTPROOT/runtest" ] || [ ! -x "$LTPROOT/kirk" ]; then
	echo "LTP install tree or its Kirk executable is missing" >&2
	exit 1
fi

case "$suite" in
	''|*[!a-zA-Z0-9_.-]*)
		echo "Invalid Kirk suite name: $suite" >&2
		exit 1
		;;
esac

printf '%s\n' "$suite" > "$suite_file"
if [ -n "${KIRK_GUEST_PATTERN:-}" ]; then
	printf '%s\n' "$KIRK_GUEST_PATTERN" > "$pattern_file"
else
	rm -f "$pattern_file"
fi
rm -f "$status_file" "$report_file" "$log_file"

docker run --rm -i --privileged \
	--tmpfs /dev/shm:rw,exec,nosuid,nodev,size=3g \
	-v "$LTPROOT:/opt/ltp" \
	-v "$repo_root/ci/nommu-uml-init.sh:/nommu-uml-init:ro" \
	--entrypoint /root/vmlinux "$image" \
	con0=fd:0,fd:1 console=tty \
	vec0:transport=raw,ifname=eth0,depth=128,gro=1 \
	root=/dev/root rootflags=/ rootfstype=hostfs rw \
	mem=2048m loglevel=0 init=/nommu-uml-init kirk_guest=1

if [ ! -s "$status_file" ]; then
	echo "UML guest exited without recording Kirk's status" >&2
	exit 1
fi

status=$(cat "$status_file")
rm -f "$status_file"
if [ "$status" != 0 ]; then
	echo "Kirk in UML guest exited with status $status" >&2
	if [ -f "$log_file" ]; then
		cat "$log_file" >&2
	fi
	exit 1
fi

if [ ! -s "$report_file" ]; then
	echo "Kirk in UML guest did not create its JSON report" >&2
	exit 1
fi

python3 - "$report_file" <<'PY'
import json
import sys

with open(sys.argv[1], encoding="utf-8") as report_file:
    stats = json.load(report_file)["stats"]

for name in ("passed", "skipped", "failed", "broken", "warnings"):
    print(f"{name}: {stats[name]}")

if any(stats[name] for name in ("failed", "broken", "warnings")):
    sys.exit(1)
PY
